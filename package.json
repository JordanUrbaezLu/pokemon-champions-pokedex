{
  "name": "pokemon-champions-pokedex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start",
    "lint": "eslint",
    "data": "node scripts/generate-dataset.mjs",
    "data:comp": "node scripts/generate-competitive.mjs",
    "data:all": "node scripts/generate-dataset.mjs && node scripts/generate-competitive.mjs",
    "refresh": "npm run data:all && npm run status && npm run audit -- --offline && npm test --if-present && npm run build",
    "status": "node scripts/status.mjs",
    "audit": "node scripts/audit-data.mjs",
    "shot": "node scripts/screenshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@smogon/calc": "^0.11.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
